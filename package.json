{
  "name": "hearth",
  "private": true,
  "version": "0.1.0",
  "description": "Hearth — an AI matchmaker dating app that gets you off the app and into real life.",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "db:migrate": "pnpm --filter @hearth/api db:migrate",
    "db:seed": "pnpm --filter @hearth/api db:seed",
    "db:reset": "pnpm --filter @hearth/api db:reset"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["@prisma/client", "@prisma/engines", "prisma", "argon2", "esbuild"]
  }
}
