# --- Database ---
DATABASE_URL="file:./dev.db"

# --- Auth (use long random strings in any real deployment) ---
JWT_ACCESS_SECRET="dev-access-secret-change-me"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL="30d"

# --- AI ---
# AI_PROVIDER=mock runs the whole app with deterministic fake AI output (no key, no cost).
# Set to "anthropic" and provide a key to use real Claude.
AI_PROVIDER="mock"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-6"

# --- Server ---
API_PORT="3001"
API_HOST="0.0.0.0"
WEB_ORIGIN="http://localhost:5173"

# --- Web (Vite, must be prefixed with VITE_) ---
VITE_API_URL="http://localhost:3001"
